{
  "name": "qsafe-rag-pipeline",
  "version": "1.0.0",
  "description": "RAG Pipeline for earthquake preparedness - Node.js backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "ingest": "npm run build && node dist/ingest.js",
    "test": "node --loader ts-node/esm scripts/test.ts",
    "evaluate": "node --loader ts-node/esm scripts/evaluate.ts",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.4.0",
    "chromadb": "^1.10.5",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "@types/uuid": "^9.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
