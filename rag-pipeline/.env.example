# Server Config
PORT=5000
NODE_ENV=development

# Gemini API Keys (add all 5 for failover)
GEMINI_API_KEY_1=your_gemini_key_1_here
GEMINI_API_KEY_2=your_gemini_key_2_here
GEMINI_API_KEY_3=your_gemini_key_3_here
GEMINI_API_KEY_4=your_gemini_key_4_here
GEMINI_API_KEY_5=your_gemini_key_5_here

# ChromaDB Cloud Vector Database
CHROMA_API_KEY=your_chromadb_cloud_api_key_here
CHROMA_TENANT=c13287d8-f0ff-4f53-8d0a-6af2863906af
CHROMA_DATABASE=disaster-responsedb
CHROMA_COLLECTION=disaster_response_db

# Logging
LOG_LEVEL=info
